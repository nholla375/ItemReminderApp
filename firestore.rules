rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isOwnerOnCreate() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function isSharedReader() {
      return signedIn()
        && resource.data.sharedWithUids is list
        && request.auth.uid in resource.data.sharedWithUids;
    }

    match /items/{itemId} {
      allow create: if isOwnerOnCreate();
      allow read: if isOwner() || isSharedReader();
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner();
    }

    match /userProfiles/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn();
    }
  }
}
